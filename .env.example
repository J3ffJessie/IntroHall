# Root domain; event pages live at {slug}.<root>, the dashboard at app.<root>.
NEXT_PUBLIC_ROOT_DOMAIN=localtest.me:3000
# From `pnpm db:start` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same value as VAPID_PUBLIC_KEY in supabase/.env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional PostHog anonymous page views, off when unset (enable cookieless mode in the PostHog project settings too).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
